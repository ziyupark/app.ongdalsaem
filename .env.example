# Copy to .env (never commit .env)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
EXPO_PUBLIC_OPENWEATHER_API_KEY=YOUR-OPENWEATHER-KEY
# DEV ONLY — test account for the dev build's 'Dev · test account' button (never set in EAS/production)
EXPO_PUBLIC_DEV_TEST_EMAIL=
EXPO_PUBLIC_DEV_TEST_PASSWORD=
